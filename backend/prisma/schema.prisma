// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            Int       @id @default(autoincrement())
  email         String    @unique @db.VarChar(100)
  password      String    @db.VarChar(255)
  full_name     String    @db.VarChar(100)
  phone         String?   @db.VarChar(50)
  address       String?   @db.Text
  sim_number    String?   @db.VarChar(50)
  sim_image     String?   @db.Text
  avatar        String?   @db.Text
  role          Role      @default(USER)
  is_verified   Boolean   @default(false)
  token         Int?
  token_expired DateTime?
  rentals       Rental[]
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@index([email])
  @@map("users")
}

enum Role {
  ADMIN
  USER
}

model Car {
  id            Int              @id @default(autoincrement())
  brand         String           @db.VarChar(50)
  model         String           @db.VarChar(40)
  year          Int              @db.SmallInt
  transmission  TransType
  capacity      Int              @db.SmallInt
  fuel_type     FuelType
  price_per_day Float
  is_active     Boolean          @default(true)
  description   String           @db.Text
  mileage       Int
  features      FeatureOnCars[]
  images        CarImage[]
  categories    CategoryOnCars[]
  rentals       Rental[]
  created_at    DateTime         @default(now())
  updated_at    DateTime         @updatedAt

  @@map("cars")
}

enum TransType {
  Manual
  Automatic
}

enum FuelType {
  Bensin
  Solar
  Listrik
}

model CarImage {
  id        Int    @id @default(autoincrement())
  car_id    Int
  car       Car    @relation(fields: [car_id], references: [id])
  image_url String

  @@map("car_images")
}

model Category {
  id            Int              @id @default(autoincrement())
  category_name String           @db.VarChar(50)
  categories    CategoryOnCars[]

  @@map("categories")
}

model CategoryOnCars {
  car         Car      @relation(fields: [car_id], references: [id])
  car_id      Int
  category    Category @relation(fields: [category_id], references: [id])
  category_id Int

  @@id([car_id, category_id])
}

model Features {
  id       Int             @id @default(autoincrement())
  feature  String          @db.Text
  features FeatureOnCars[]

  @@map("features")
}

model FeatureOnCars {
  car        Car      @relation(fields: [car_id], references: [id])
  car_id     Int
  features   Features @relation(fields: [feature_id], references: [id])
  feature_id Int

  @@id([car_id, feature_id])
}

model Rental {
  id            Int          @id @default(autoincrement())
  user          User         @relation(fields: [user_id], references: [id])
  user_id       Int
  car           Car          @relation(fields: [car_id], references: [id])
  car_id        Int
  start_date    DateTime
  end_date      DateTime
  total_price   Float
  driver_needed Boolean      @default(false)
  driver_fee    Float?
  status        RentalStatus @default(PENDING)
  payment       Payment?
  created_at    DateTime     @default(now())
  updated_at    DateTime     @updatedAt

  @@index([car_id, start_date, end_date])
  @@map("rentals")
}

model Payment {
  id                Int           @id @default(autoincrement())
  rental            Rental        @relation(fields: [rental_id], references: [id])
  rental_id         Int           @unique
  amount            Float
  midtrans_order_id String        @unique
  snap_token        String?
  status            PaymentStatus @default(PENDING)
  payment_method    String?
  paid_at           DateTime?
  expiry_time       DateTime
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  @@map("payments")
}

enum PaymentStatus {
  PENDING
  PAID
  EXPIRED
  FAILED
  REFUNDED
}

enum RentalStatus {
  PENDING
  CONFIRMED
  ACTIVE
  COMPLETED
  CANCELLED
}
